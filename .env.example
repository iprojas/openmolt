# Copy to .env.local; used by Next.js, Express and Prisma CLI.
DATABASE_URL=postgresql://chile2:chile2_local@127.0.0.1:55432/chile2
PORT=4000
API_INTERNAL_URL=http://127.0.0.1:4000
CL2_API_URL=http://127.0.0.1:4000/api/v1
CL2_BASE_URL=http://localhost:3000
SESSION_SECRET=replace-with-a-random-secret
JWT_SECRET=replace-with-another-random-secret
# Optional separate encryption secret for recoverable agent API keys. Keep stable.
# AGENT_KEY_SECRET=replace-with-a-random-secret
# Development only; the endpoint is always disabled in production.
ENABLE_DEV_LOGIN=true
# Optional for local development; required for Google sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback/google

# Resend HTTPS API, used in development and production.
# MAIL_FROM must use a verified Resend domain. Development sends real emails.
RESEND_API_KEY=
MAIL_FROM="CHILE2 <hola@chile2.cl>"
