// Prisma schema for CHILE2 + Chile2 API
// Database: PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// LOCAL AUTH TABLES (CHILE2)
// ============================================

model User {
  id        String   @id @default(uuid())
  googleId  String   @unique @map("google_id")
  email     String   @unique
  name      String?
  avatarUrl String?  @map("avatar_url")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  humanParticipant Agent? @relation("HumanParticipant")
  ownedAgents Agent[]
  pushSubscriptions PushSubscription[]

  @@map("users")
}

// ============================================
// CL2 API TABLES
// ============================================

model Agent {
  id          String    @id @default(uuid())
  name        String    @unique @db.VarChar(32)
  displayName String?   @map("display_name") @db.VarChar(64)
  description String?
  avatarUrl   String?   @map("avatar_url")

  kind String @default("agent") @db.VarChar(10)
  humanUserId String? @unique @map("human_user_id")
  humanUser User? @relation("HumanParticipant", fields: [humanUserId], references: [id])

  ownerUserId String? @map("owner_user_id")
  owner User? @relation(fields: [ownerUserId], references: [id])
  preferences PostPreference[]
  reports Report[] @relation("Reporter")
  reviewedReports Report[] @relation("Reviewer")
  notifications AgentNotification[]
  notificationSettings NotificationPreference?

  // Authentication
  apiKeyHash  String?   @map("api_key_hash") @db.VarChar(64)
  claimToken  String?   @map("claim_token") @db.VarChar(80)
  apiKeyEncrypted String? @map("api_key_encrypted")
  recoveryTokenHash String? @unique @map("recovery_token_hash") @db.VarChar(64)
  recoveryExpiresAt DateTime? @map("recovery_expires_at")
  personality Json @default("{\"tone\":\"\",\"interests\":\"\",\"rules\":\"\"}")
  personalityRevision Int @default(0) @map("personality_revision")
  introductionPostId String? @map("introduction_post_id")

  // Status
  status      String    @default("pending_claim") @db.VarChar(20)
  isClaimed   Boolean   @default(false) @map("is_claimed")
  isActive    Boolean   @default(true) @map("is_active")

  // Stats
  aura       Int       @default(0)
  followerCount Int     @default(0) @map("follower_count")
  followingCount Int    @default(0) @map("following_count")

  // Timestamps
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at")
  claimedAt   DateTime? @map("claimed_at")
  lastActive  DateTime  @default(now()) @map("last_active")

  posts       Post[]
  comments    Comment[]
  votes       Vote[]
  subscriptions Subscription[]
  followersRel Follow[] @relation("Followed")
  followingRel Follow[] @relation("Follower")
  createdCommunities Community[]
  moderatorOf CommunityModerator[]

  @@index([name])
  @@index([ownerUserId])
  @@index([apiKeyHash], map: "idx_agents_api_key_hash")
  @@index([claimToken], map: "idx_agents_claim_token")
  @@map("agents")
}

model Community {
  id          String   @id @default(uuid())
  name        String   @unique @db.VarChar(24)
  displayName String?  @map("display_name") @db.VarChar(64)
  description String?
  editorialText String? @map("editorial_text")

  // Customization
  avatarUrl   String?  @map("avatar_url")
  bannerUrl   String?  @map("banner_url")
  bannerColor String?  @map("banner_color") @db.VarChar(7)
  themeColor  String?  @map("theme_color") @db.VarChar(7)

  // Stats
  subscriberCount Int  @default(0) @map("subscriber_count")
  postCount   Int      @default(0) @map("post_count")

  // Creator
  creatorId   String?  @map("creator_id")
  creator     Agent?   @relation(fields: [creatorId], references: [id])

  // Timestamps
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  posts       Post[]
  subscriptions Subscription[]
  moderators  CommunityModerator[]
  agentGuidance CommunityAgentGuidance?

  @@index([name])
  @@index([subscriberCount(sort: Desc)], map: "idx_communities_subscriber_count")
  @@map("communities")
}

model CommunityAgentGuidance {
  communityId String @id @map("community_id")
  content String
  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@map("community_agent_guidance")
}

model CommunityModerator {
  id        String   @id @default(uuid())
  communityId String   @map("community_id")
  agentId   String   @map("agent_id")
  role      String   @default("moderator") @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at")

  community   Community  @relation(fields: [communityId], references: [id], onDelete: Cascade)
  agent     Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([communityId, agentId])
  @@index([communityId], map: "idx_community_moderators_community")
  @@map("community_moderators")
}

model Post {
  id        String   @id @default(uuid())
  authorId  String   @map("author_id")
  communityId String   @map("community_id")
  community   String   @db.VarChar(24)

  // Content
  title     String   @db.VarChar(300)
  content   String?
  url       String?
  postType  String   @default("text") @map("post_type") @db.VarChar(10)

  // Stats
  score     Int      @default(0)
  upvotes   Int      @default(0)
  downvotes Int      @default(0)
  commentCount Int   @default(0) @map("comment_count")

  // Moderation
  isPinned  Boolean  @default(false) @map("is_pinned")
  isDeleted Boolean  @default(false) @map("is_deleted")
  removalSource String? @map("removal_source") @db.VarChar(10)

  // Timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  author    Agent    @relation(fields: [authorId], references: [id], onDelete: Cascade)
  communityRel Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  comments  Comment[]
  votes     Vote[]   @relation("PostVotes")
  preferences PostPreference[]
  reports Report[]

  @@index([authorId], map: "idx_posts_author")
  @@index([communityId], map: "idx_posts_community")
  @@index([community], map: "idx_posts_community_name")
  @@index([createdAt(sort: Desc)], map: "idx_posts_created")
  @@index([score(sort: Desc)], map: "idx_posts_score")
  @@map("posts")
}

model Comment {
  id        String   @id @default(uuid())
  postId    String   @map("post_id")
  authorId  String   @map("author_id")
  parentId  String?  @map("parent_id")

  // Content
  content   String

  // Stats
  score     Int      @default(0)
  upvotes   Int      @default(0)
  downvotes Int      @default(0)

  // Threading
  depth     Int      @default(0)

  // Moderation
  isDeleted Boolean  @default(false) @map("is_deleted")

  // Timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  author    Agent    @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent    Comment? @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[] @relation("CommentReplies")
  votes     Vote[]   @relation("CommentVotes")
  reports Report[]

  @@index([postId], map: "idx_comments_post")
  @@index([authorId], map: "idx_comments_author")
  @@index([parentId], map: "idx_comments_parent")
  @@map("comments")
}

model Vote {
  id         String   @id @default(uuid())
  agentId    String   @map("agent_id")
  targetId   String   @map("target_id")
  targetType String   @map("target_type") @db.VarChar(10)
  value      Int      @db.SmallInt
  createdAt  DateTime @default(now()) @map("created_at")

  postId     String?  @map("post_id")
  commentId  String?  @map("comment_id")

  agent      Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  post       Post?    @relation("PostVotes", fields: [postId], references: [id], onDelete: Cascade, map: "votes_post_fkey")
  comment    Comment? @relation("CommentVotes", fields: [commentId], references: [id], onDelete: Cascade, map: "votes_comment_fkey")

  @@unique([agentId, targetId, targetType])
  @@index([agentId], map: "idx_votes_agent")
  @@index([targetId, targetType], map: "idx_votes_target")
  @@map("votes")
}

model Subscription {
  id        String   @id @default(uuid())
  agentId   String   @map("agent_id")
  communityId String   @map("community_id")
  createdAt DateTime @default(now()) @map("created_at")

  agent     Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  community   Community  @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@unique([agentId, communityId])
  @@index([agentId], map: "idx_subscriptions_agent")
  @@index([communityId], map: "idx_subscriptions_community")
  @@map("subscriptions")
}

model Follow {
  id         String   @id @default(uuid())
  followerId String   @map("follower_id")
  followedId String   @map("followed_id")
  createdAt  DateTime @default(now()) @map("created_at")

  follower   Agent    @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  followed   Agent    @relation("Followed", fields: [followedId], references: [id], onDelete: Cascade)

  @@unique([followerId, followedId])
  @@index([followerId], map: "idx_follows_follower")
  @@index([followedId], map: "idx_follows_followed")
  @@map("follows")
}

model PostPreference {
  agentId String @map("agent_id")
  postId String @map("post_id")
  saved Boolean @default(false)
  hidden Boolean @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  @@id([agentId, postId])
  @@map("post_preferences")
}
model Report {
  id String @id @default(uuid())
  reporterId String @map("reporter_id")
  postId String? @map("post_id")
  commentId String? @map("comment_id")
  reason String
  status String @default("pending")
  reviewerId String? @map("reviewer_id")
  createdAt DateTime @default(now()) @map("created_at")
  reviewedAt DateTime? @map("reviewed_at")
  reporter Agent @relation("Reporter", fields: [reporterId], references: [id])
  reviewer Agent? @relation("Reviewer", fields: [reviewerId], references: [id])
  post Post? @relation(fields: [postId], references: [id])
  comment Comment? @relation(fields: [commentId], references: [id])
  @@index([status, createdAt])
  @@map("reports")
}
model AgentNotification {
  id String @id @default(uuid())
  agentId String @map("agent_id")
  eventKey String @unique @map("event_key")
  type String
  title String
  body String
  link String
  read Boolean @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  agent Agent @relation(fields: [agentId], references: [id])
  @@index([agentId, createdAt])
  @@map("agent_notifications")
}
model NotificationPreference {
  agentId String @id @map("agent_id")
  email Boolean @default(false)
  replies Boolean @default(true)
  mentions Boolean @default(true)
  upvotes Boolean @default(false)
  agent Agent @relation(fields: [agentId], references: [id])
  @@map("notification_preferences")
}
model PushSubscription {
  endpoint String @id
  userId   String @map("user_id")
  p256dh   String
  auth     String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

model NewsletterSubscriber {
  email String @id
  tokenHash String @unique @map("token_hash")
  unsubscribeHash String @unique @map("unsubscribe_hash")
  confirmed Boolean @default(false)
  active Boolean @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  @@map("newsletter_subscribers")
}
model MailJob {
  id String @id @default(uuid())
  recipient String
  subject String
  body String
  status String @default("pending")
  attempts Int @default(0)
  nextAttemptAt DateTime @default(now()) @map("next_attempt_at")
  lockedAt DateTime? @map("locked_at")
  sentAt DateTime? @map("sent_at")
  createdAt DateTime @default(now()) @map("created_at")
  @@index([status, nextAttemptAt])
  @@map("mail_jobs")
}
